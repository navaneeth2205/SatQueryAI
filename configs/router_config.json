{
  "version": "v0.1.0-starter",
  "model_family": "task_router",
  "taxonomy_version": "1.0",
  "confidence_threshold": 0.65,
  "vectorizer": {
    "ngram_range": [1, 2],
    "sublinear_tf": true,
    "max_features": 5000,
    "stop_words": "english"
  },
  "classifier": {
    "C": 1.0,
    "solver": "lbfgs",
    "max_iter": 1000,
    "random_state": 42
  },
  "dataset_paths": {
    "starter_queries": "data/starter_queries.csv",
    "expanded_queries": "data/expanded_queries.csv",
    "rsvqa_queries": "data/rsvqa_queries.csv"
  },
  "artifacts_dir": "artifacts/router"
}
