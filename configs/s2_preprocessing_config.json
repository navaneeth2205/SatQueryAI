{
  "description": "Frozen Sentinel-2 Level-2A preprocessing and baseline reconciliation parameters for Phase 4 Stage B gate.",
  "processing_baselines": {
    "archival": {
      "condition": "PB < 04.00",
      "boa_add_offset": 0.0,
      "quantification_value": 10000.0,
      "formula": "DN / 10000.0"
    },
    "modern_operational": {
      "condition": "PB >= 04.00",
      "boa_add_offset": -1000.0,
      "quantification_value": 10000.0,
      "formula": "(DN - 1000.0) / 10000.0"
    }
  },
  "physical_tolerance": {
    "nominal_range": [-0.05, 1.20],
    "clipping_policy": "none (no silent force-clipping to [0, 1])",
    "finite_check": "reject non-finite NaN or Inf with ERR_NON_FINITE_TENSOR"
  },
  "optical_standardization": {
    "means": [0.136, 0.118, 0.106, 0.128, 0.203, 0.257, 0.272, 0.273, 0.187, 0.121],
    "stds": [0.082, 0.076, 0.074, 0.089, 0.098, 0.108, 0.113, 0.112, 0.095, 0.078],
    "channel_order": ["B02", "B03", "B04", "B05", "B06", "B07", "B08", "B8A", "B11", "B12"],
    "tensor_shape": [10, 120, 120]
  },
  "sar_normalization": {
    "db_min": -35.0,
    "db_max": 5.0,
    "db_span": 40.0,
    "channel_order": ["VH", "VV"],
    "tensor_shape": [2, 120, 120]
  },
  "resampling": {
    "method": "bilinear",
    "align_corners": false,
    "native_20m_bands": ["B05", "B06", "B07", "B8A", "B11", "B12"],
    "target_gsd_meters": 10.0,
    "target_shape": [120, 120]
  }
}
